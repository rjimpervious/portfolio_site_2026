---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="border-t border-line/60 px-4 py-8 sm:px-8">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 font-mono text-sm text-muted">
    <p>© {year} {profile.name}</p>
    <p>built with <span class="text-neon">astro</span> · hosted on <span class="text-pink-soft">github pages</span></p>
  </div>
</footer>

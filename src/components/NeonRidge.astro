---
// Wireframe mountain ridges drawn in neon: the nature-meets-cyberpunk backdrop.
---

<div class="pointer-events-none absolute inset-x-0 bottom-0 h-[55%] overflow-hidden" aria-hidden="true">
  <svg class="ridge-drift absolute -inset-x-[5%] bottom-0 h-full w-[110%]" viewBox="0 0 1200 400" preserveAspectRatio="none">
    <defs>
      <linearGradient id="ridge-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#39ff88" stop-opacity=".14" />
        <stop offset="1" stop-color="#070b0a" stop-opacity="0" />
      </linearGradient>
    </defs>
    <path d="M0 330 L120 250 L210 290 L330 170 L420 240 L520 140 L600 210 L700 120 L820 230 L930 160 L1040 250 L1200 190 L1200 400 L0 400Z"
      fill="url(#ridge-fade)" stroke="#39ff88" stroke-opacity=".55" stroke-width="1.5" vector-effect="non-scaling-stroke" />
    <path d="M0 360 L150 300 L260 340 L380 260 L500 320 L640 230 L760 300 L880 250 L1010 320 L1120 280 L1200 310"
      fill="none" stroke="#ff2e97" stroke-opacity=".45" stroke-width="1.5" vector-effect="non-scaling-stroke" />
    <g stroke="#39ff88" stroke-opacity=".12" vector-effect="non-scaling-stroke">
      <path d="M330 170 L380 400 M520 140 L500 400 M700 120 L760 400 M930 160 L900 400" />
    </g>
  </svg>
</div>

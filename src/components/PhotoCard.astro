---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  index?: number;
  class?: string;
  imgClass?: string;
  sizes?: string;
}
const {
  src,
  alt,
  caption,
  index = 0,
  class: cls = '',
  imgClass = 'aspect-[4/5]',
  sizes = '(min-width: 768px) 33vw, 100vw',
} = Astro.props;
---

<figure data-reveal style={`--d:${(index % 3) * 120}`} class:list={['card card-pink group relative overflow-hidden p-0', cls]}>
  <Image
    src={src}
    alt={alt}
    widths={[400, 700, 1000, 1400]}
    sizes={sizes}
    class:list={['h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]', imgClass]}
  />
  <div class="shade-caption pointer-events-none absolute inset-0"></div>
  <figcaption class="absolute inset-x-0 bottom-0 flex items-center gap-2 p-5 text-base font-medium text-ink">
    <span class="h-2 w-2 rounded-full bg-pink shadow-[0_0_10px_rgb(255_46_151)]" aria-hidden="true"></span>
    {caption}
  </figcaption>
</figure>

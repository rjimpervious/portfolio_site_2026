---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  index?: number;
}
const { src, alt, caption, index = 0 } = Astro.props;
---

<figure data-reveal style={`--d:${index * 120}`} class="card card-pink group relative overflow-hidden p-0">
  <Image
    src={src}
    alt={alt}
    widths={[400, 700, 1000]}
    sizes="(min-width: 768px) 33vw, 100vw"
    class="aspect-[4/5] w-full object-cover transition duration-700 group-hover:scale-[1.04]"
  />
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void via-void/10 to-transparent"></div>
  <figcaption class="absolute inset-x-0 bottom-0 flex items-center gap-2 p-5 font-mono text-sm text-ink">
    <span class="h-2 w-2 rounded-full bg-pink shadow-[0_0_10px_rgb(255_46_151)]" aria-hidden="true"></span>
    {caption}
  </figcaption>
</figure>

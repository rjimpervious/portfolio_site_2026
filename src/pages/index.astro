---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import NeonRidge from '../components/NeonRidge.astro';
import TimelineItem from '../components/TimelineItem.astro';
import Icon from '../components/Icon.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import headshot from '../assets/photos/headshot.webp';
import teaserPhoto from '../assets/photos/breithorn.webp';
import { profile, experience, education, skills, life } from '../data/profile';
---

<Base>
  <SiteHeader />

  <main id="top">
    <!-- ============ HERO ============ -->
    <section class="relative flex min-h-dvh items-center overflow-hidden px-4 pt-24 pb-20 sm:px-8">
      <div class="cyber-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <NeonRidge />
      <div class="relative mx-auto grid w-full max-w-6xl items-center gap-12 md:grid-cols-[1.3fr_1fr] md:gap-16">
        <div>
          <p data-reveal class="cursor font-mono text-base text-neon">// hello, world. I'm</p>
          <h1 data-reveal style="--d:100" class="mt-4 font-display text-[3.2rem] leading-[1.02] font-bold tracking-tight sm:text-7xl xl:text-[5.25rem]">
            <span class="glitch" data-text="Rannie John">Rannie John</span><br />
            <span class="neon-gradient-text">Lopez</span>
          </h1>
          <p data-reveal style="--d:200" class="mt-6 font-mono text-lg text-pink-soft sm:text-xl">&gt; {profile.role}</p>
          <p data-reveal style="--d:300" class="mt-4 max-w-xl text-xl leading-relaxed text-ink sm:text-2xl sm:leading-snug">{profile.pitch}</p>
          <p data-reveal style="--d:350" class="mt-5 flex items-start gap-2 text-base text-muted">
            <Icon name="pin" class="mt-1 h-4 w-4 shrink-0 text-neon" /> <span>{profile.location} · {profile.workAuth}</span>
          </p>
          <div data-reveal style="--d:450" class="mt-9 flex flex-wrap gap-3">
            <a href="#contact" class="btn btn-primary">Get in touch <Icon name="arrow" class="h-4 w-4" /></a>
            <a href={profile.links.linkedin} target="_blank" rel="noopener" class="btn btn-ghost"><Icon name="linkedin" class="h-4 w-4" /> LinkedIn</a>
            <a href={profile.links.github} target="_blank" rel="noopener" class="btn btn-ghost"><Icon name="github" class="h-4 w-4" /> GitHub</a>
          </div>
        </div>

        <div data-reveal style="--d:250" class="mx-auto w-full max-w-[21rem] md:max-w-sm">
          <div class="portrait-frame">
            <Image
              src={headshot}
              alt={`Portrait of ${profile.name}`}
              widths={[360, 560, 800]}
              sizes="(min-width: 768px) 420px, 88vw"
              loading="eager"
              class="aspect-square w-full rounded-[calc(1.75rem-3px)] object-cover"
            />
            <span class="corner -top-3 -left-3 border-t-2 border-l-2" aria-hidden="true"></span>
            <span class="corner -right-3 -bottom-3 border-r-2 border-b-2 !border-pink" aria-hidden="true"></span>
          </div>
          <p class="mt-4 text-center font-mono text-sm text-muted">status: <span class="text-neon">open to opportunities</span></p>
        </div>
      </div>
    </section>

    <!-- ============ ABOUT ============ -->
    <Section id="about" label="about" title="Pipelines that run while you sleep.">
      <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
        <div data-reveal class="space-y-5 text-[1.15rem] leading-relaxed text-ink">
          {profile.summary.map((p) => <p>{p}</p>)}
          <p class="text-base text-muted">
            <span class="font-medium text-neon">Education:</span> {education.degree}, {education.school} ({education.period})
          </p>
        </div>
        <dl class="grid grid-cols-2 gap-4">
          {profile.facts.map((f, i) => (
            <div data-reveal style={`--d:${i * 90}`} class:list={['card p-5', i % 2 && 'card-pink']}>
              <dt class="sr-only">{f.label}</dt>
              <dd>
                <span class:list={['block font-display text-3xl font-bold', i % 2 ? 'text-pink-soft text-glow-pink' : 'text-neon text-glow']}>{f.value}</span>
                <span class="mt-1 block text-[0.95rem] text-muted">{f.label}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </Section>

    <!-- ============ EXPERIENCE ============ -->
    <Section id="experience" label="experience" title="Where I've shipped." accent="pink">
      <ol class="relative ml-1.5 space-y-8 border-l border-dashed border-line">
        {experience.map((job, i) => <TimelineItem {...job} current={i === 0} index={i} />)}
      </ol>
    </Section>

    <!-- ============ SKILLS ============ -->
    <Section id="skills" label="stack" title="Tools of the trade.">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {skills.map((s, i) => (
          <div data-reveal style={`--d:${i * 70}`} class:list={['card p-6', i % 2 && 'card-pink']}>
            <h3 class="font-display text-lg font-semibold text-pink-soft">{s.group}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {s.items.map((item) => <li class="chip">{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </Section>

    <!-- ============ LIFE TEASER ============ -->
    <section class="px-4 py-12 sm:px-8">
      <a href="/life/" data-reveal class="card card-pink group mx-auto grid max-w-6xl overflow-hidden md:grid-cols-[1fr_1.2fr]">
        <div class="relative h-64 md:h-auto">
          <Image src={teaserPhoto} alt="RJ on the Breithorn summit ridge" widths={[500, 800]} sizes="(min-width: 768px) 45vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_35%] transition duration-700 group-hover:scale-[1.04]" />
          <div class="absolute inset-0 bg-gradient-to-t from-surface/70 to-transparent md:bg-gradient-to-r md:from-transparent md:to-surface/40"></div>
        </div>
        <div class="p-7 sm:p-10">
          <p class="font-mono text-base text-pink-soft">// life_outside_work</p>
          <h2 class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">Summits, marathons &amp; 23 countries.</h2>
          <p class="mt-4 text-[1.1rem] leading-relaxed text-ink">{life.intro}</p>
          <ul class="mt-6 grid grid-cols-2 gap-3">
            {life.stats.map((s) => (
              <li class="rounded-xl border border-line bg-surface-2 px-4 py-3">
                <span class="block font-display text-xl font-semibold text-neon">{s.value}</span>
                <span class="block text-sm text-muted">{s.label}</span>
              </li>
            ))}
          </ul>
          <span class="mt-7 inline-flex items-center gap-2 font-semibold text-pink-soft group-hover:text-pink">
            See life beyond the terminal <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1" />
          </span>
        </div>
      </a>
    </section>

    <!-- ============ CONTACT ============ -->
    <Section id="contact" label="contact" title="Let's build something reliable.">
      <div data-reveal class="card relative overflow-hidden p-8 sm:p-12">
        <div class="cyber-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
        <div class="relative grid items-center gap-8 md:grid-cols-[1.3fr_1fr]">
          <p class="text-[1.15rem] leading-relaxed text-ink">
            Open to data platform, data engineering and DevOps roles in Munich, remote, or across the EU.
            The fastest way to reach me is email.
          </p>
          <div class="flex flex-col gap-3">
            <a href={`mailto:${profile.email}`} class="btn btn-primary justify-center"><Icon name="mail" class="h-4 w-4" /> {profile.email}</a>
            <div class="grid grid-cols-2 gap-3">
              <a href={profile.links.linkedin} target="_blank" rel="noopener" class="btn btn-ghost justify-center"><Icon name="linkedin" class="h-4 w-4" /> LinkedIn</a>
              <a href={profile.links.github} target="_blank" rel="noopener" class="btn btn-ghost justify-center"><Icon name="github" class="h-4 w-4" /> GitHub</a>
            </div>
          </div>
        </div>
      </div>
    </Section>
  </main>

  <SiteFooter />
</Base>
